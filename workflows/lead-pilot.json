      "position": [1700, 620]
    },
    {
      "parameters": {
        "fromEmail": "hello@lazyscale.ai",
        "toEmail": "={{ $json.email }}",
        "subject": "=Following up — {{ $json.name }}",
        "text": "=Hey {{ $json.name }},\n\nJust checking in about automating some work for {{ $json.company }}.\n\nNo pressure — grab a slot if curious: https://cal.com/lazy_scale/15min\n\n— LazyScale"
      },
      "id": "dddddddd-dddd-dddd-dddd-dddddddddddd",
      "name": "Email Cold Follow-Up",
