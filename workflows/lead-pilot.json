{
  "name": "Lead Pilot — LazyScale",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-pilot",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "lead-pilot"
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "name", "value": "={{ $json.body.name || $json.name || 'Unknown' }}" },
            { "name": "email", "value": "={{ $json.body.email || $json.email || '' }}" },
            { "name": "company", "value": "={{ $json.body.company || $json.company || 'Not provided' }}" },
            { "name": "message", "value": "={{ $json.body.message || $json.message || '' }}" },
            { "name": "source", "value": "={{ $json.body.source || $json.source || 'website' }}" },
            { "name": "timestamp", "value": "={{ new Date().toISOString() }}" }
          ]
        },
        "options": {}
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Set Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParametersUi": {
          "parameter": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.3,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a lead qualification assistant. Analyze the incoming lead and return a JSON object with: score (1-10), tier (hot/warm/cold), reason (one sentence), suggested_reply (2-3 sentences). Scoring: company name +2, specific pain point +3, budget/timeline +2, detailed message +1, business email +2. Return ONLY valid JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.name }}\\nEmail: {{ $json.email }}\\nCompany: {{ $json.company }}\\nMessage: {{ $json.message }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "AI Qualify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [720, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet ai;\ntry {\n  ai = JSON.parse(input.choices[0].message.content);\n} catch(e) {\n  ai = { score:5, tier:'warm', reason:'Parse error', suggested_reply:'Thanks for reaching out! Would you be open to a quick call?' };\n}\nconst lead = $('Set Lead Data').first().json;\nreturn [{json:{...lead, ai_score:ai.score, ai_tier:ai.tier, ai_reason:ai.reason, ai_reply:ai.suggested_reply}}];"
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.ai_tier }}",
              "value2": "hot"
            }
          ]
        }
      },
      "id": "a5555555-5555-5555-5555-555555555555",
      "name": "Is Hot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.ai_tier }}",
              "value2": "warm"
            }
          ]
        }
      },
      "id": "a6666666-6666-6666-6666-666666666666",
      "name": "Is Warm?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1440, 460]
    },
    {
      "parameters": {
        "channel": "#leads",
        "text": "=:fire: *HOT LEAD ({{ $json.ai_score }}/10)*\n*{{ $json.name }}* ({{ $json.email }})\nCompany: {{ $json.company }}\n> {{ $json.message }}\nAI: {{ $json.ai_reason }}\nReply: {{ $json.ai_reply }}"
      },
      "id": "a7777777-7777-7777-7777-777777777777",
      "name": "Slack Hot",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1440, 140],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "channel": "#leads",
        "text": "=:large_yellow_circle: *WARM LEAD ({{ $json.ai_score }}/10)*\n*{{ $json.name }}* ({{ $json.email }})\n> {{ $json.message }}\nAI: {{ $json.ai_reason }}"
      },
      "id": "a8888888-8888-8888-8888-888888888888",
      "name": "Slack Warm",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1700, 300],
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "hello@lazyscale.ai",
        "toEmail": "={{ $json.email }}",
        "subject": "=Re: {{ $json.company }}",
        "text": "={{ $json.ai_reply }}\n\nBook a call: https://cal.com/lazy_scale/15min\n\n— LazyScale"
      },
      "id": "a9999999-9999-9999-9999-999999999999",
      "name": "Email Hot",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1700, 140],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP"
        }
      }
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "minutes"
      },
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "name": "Wait 30m",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1700, 460]
    },
    {
      "parameters": {
        "fromEmail": "hello@lazyscale.ai",
        "toEmail": "={{ $json.email }}",
        "subject": "=Hey {{ $json.name }}",
        "text": "={{ $json.ai_reply }}\n\nGrab a time: https://cal.com/lazy_scale/15min\n\n— LazyScale"
      },
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Email Warm",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1940, 460],
      "credentials": {
